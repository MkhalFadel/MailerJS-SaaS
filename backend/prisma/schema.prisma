generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model users {
  id            String   @id @default(uuid())
  email         String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  first_name    String
  last_name     String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  contacts      contacts[]
  templates     templates[]
  smtp_accounts  smtp_accounts[]
  campaigns      campaigns[]
}

model contacts {
  id         String   @id @default(uuid())
  user_id    String
  email      String   @db.VarChar(255)
  first_name String?
  last_name  String?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, email])
  @@index([user_id])
}

model templates {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  subject    String
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  campaigns      campaigns[]

  @@index([user_id])
}

model smtp_accounts {
  id                   String   @id @default(uuid())
  user_id              String
  provider             String
  host                 String
  port                 Int
  secure               Boolean  @default(false)
  username             String
  password_encrypted   String
  sender_name          String?
  sender_email         String
  is_default            Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  campaigns      campaigns[]

  @@index([user_id])
}

model campaigns {
    id              String        @id @default(uuid())
    user_id         String
    name            String
    subject         String
    template_id     String
    smtp_account_id String
    status          String        @default("draft")
    created_at      DateTime      @default(now()) @db.Timestamptz(6)
    updated_at      DateTime      @updatedAt @db.Timestamptz(6)

    user         users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
    template     templates    @relation(fields: [template_id], references: [id], onDelete: Restrict)
    smtp_account smtp_accounts @relation(fields: [smtp_account_id], references: [id], onDelete: Restrict)

    @@index([user_id])
    @@index([template_id])
    @@index([smtp_account_id])
}